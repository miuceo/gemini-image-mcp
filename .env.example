# Copy this file to .env and fill in your Gemini web app session cookies.
# See README.md "Getting your cookies" section for how to obtain these.

# Optional if a browser is signed in to Gemini (see GEMINI_COOKIE_SOURCE below):
# value of the __Secure-1PSID cookie from gemini.google.com
GEMINI_1PSID=

# Optional, as above: value of the __Secure-1PSIDTS cookie from gemini.google.com
GEMINI_1PSIDTS=

# Optional: directory where generated images and the gallery are stored
# (default: <project root>/output)
GEMINI_OUTPUT_DIR=

# Optional: path where refreshed cookies are persisted across restarts
# (default: a private per-user folder, e.g. %LOCALAPPDATA%\gemini-image-mcp\cookies on Windows,
#  ~/.local/state/gemini-image-mcp/cookies on Linux). Keep it outside GEMINI_OUTPUT_DIR.
GEMINI_COOKIE_PATH=

# Optional: default Gemini model to use (default: account default)
GEMINI_DEFAULT_MODEL=

# Optional: request timeout in seconds (default: 120)
GEMINI_TIMEOUT=120

# Optional: proxy URL for outgoing requests to the Gemini web app
GEMINI_PROXY=

# Optional: where cookies come from (default: auto)
#   auto    - use GEMINI_1PSID above if set (falling back to a browser if it is stale),
#             otherwise read them from the first signed-in browser: Firefox, LibreWolf,
#             Edge, Chrome, Brave, Chromium, Vivaldi, Opera (macOS: Firefox/LibreWolf only)
#   env     - only the values above
#   firefox / librewolf / edge / chrome / brave / chromium / vivaldi / opera / safari
#           - always read from that one browser (sign in to gemini.google.com there once)
# Note: Chrome on Windows can't be read (app-bound encryption); use Firefox or Edge.
GEMINI_COOKIE_SOURCE=

# Optional: a specific profile's cookie database for that browser (for auto: Firefox's
# cookies.sqlite). GEMINI_FIREFOX_COOKIE_FILE is still accepted as the older name.
GEMINI_BROWSER_COOKIE_FILE=

# ---------------------------------------------------------------------------
# Optional: publish generated images to a GitHub repository
# ---------------------------------------------------------------------------
# Leave GEMINI_GITHUB_REPO empty to disable publishing entirely (the default).

# Target repository as owner/name, e.g. yourname/my-images
GEMINI_GITHUB_REPO=

# Token with write access to that repo. Recommended: a fine-grained token limited to that
# single repository with only "Contents: read and write".
# If empty, falls back to GITHUB_TOKEN, then to `gh auth token` from the GitHub CLI (whose
# token usually has access to ALL your repositories - prefer a dedicated token).
GEMINI_GITHUB_TOKEN=

# Branch to commit to (default: the repository's default branch)
GEMINI_GITHUB_BRANCH=

# Folder inside the repo to upload into (default: images)
GEMINI_GITHUB_PATH=

# Publish every new image automatically (default: false). By default images are published
# only when a tool call passes publish=true, or via the publish_image tool.
GEMINI_GITHUB_AUTO_PUBLISH=

# Name files after the prompt and include it in commit messages (default: false, which
# uses only the image id so prompts never appear in the repo or its history).
GEMINI_GITHUB_INCLUDE_PROMPT=
