# Copy this file to .env and fill in your Gemini web app session cookies.
# See README.md "Getting your cookies" section for how to obtain these.

# Optional if you use Firefox (see below): value of the __Secure-1PSID cookie from gemini.google.com
GEMINI_1PSID=

# Optional if you use Firefox (see below): value of the __Secure-1PSIDTS cookie from gemini.google.com
GEMINI_1PSIDTS=

# Optional: directory where generated images and the gallery are stored
# (default: <project root>/output)
GEMINI_OUTPUT_DIR=

# Optional: path where refreshed cookies are persisted across restarts
# (default: <GEMINI_OUTPUT_DIR>/.cookies)
GEMINI_COOKIE_PATH=

# Optional: default Gemini model to use (default: account default)
GEMINI_DEFAULT_MODEL=

# Optional: request timeout in seconds (default: 120)
GEMINI_TIMEOUT=120

# Optional: proxy URL for outgoing requests to the Gemini web app
GEMINI_PROXY=

# Optional: where cookies come from (default: auto)
#   auto    - use GEMINI_1PSID above if set (falling back to Firefox if it is stale),
#             otherwise read them from your Firefox profile
#   env     - only the values above
#   firefox - always read from Firefox (sign in to gemini.google.com there once)
GEMINI_COOKIE_SOURCE=

# Optional: a specific Firefox profile's cookies.sqlite (default: Firefox default profile)
GEMINI_FIREFOX_COOKIE_FILE=
